    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
