{
  "name": "project-ferret",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A virtual pet game: raise one ferret with someone you care about.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
